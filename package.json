{
  "name": "certamaris-marketing-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env STATIC_EXPORT=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ci:validate": "npm audit --omit=dev --audit-level=high && npm run typecheck && npm run test:pricing && npm run build:static",
    "qa": "node scripts/qa/run-all.mjs",
    "qa:content": "node scripts/qa/content-qa.mjs",
    "qa:product-proof": "node scripts/qa/check-product-proof.mjs",
    "qa:product-proof:render": "node scripts/qa/check-product-proof-render.mjs",
    "qa:product-experience": "node scripts/qa/check-product-experience.mjs",
    "qa:buyer-paths": "node scripts/qa/check-buyer-paths.mjs",
    "qa:excellence": "node scripts/qa/check-excellence-path.mjs",
    "qa:public-product-boundary": "node scripts/qa/check-public-product-boundary.mjs",
    "qa:routes": "node scripts/qa/check-routes.mjs --out --include-planned",
    "qa:seo": "node scripts/qa/check-seo.mjs",
    "qa:link-preview": "node scripts/qa/check-link-preview.mjs",
    "qa:links": "node scripts/qa/check-links.mjs",
    "qa:founder": "node scripts/qa/check-founder.mjs",
    "qa:responsive-a11y": "node scripts/qa/responsive-a11y-qa.mjs",
    "test:pricing": "node --experimental-strip-types --test lib/pricing-calculator.test.ts",
    "test:contact": "node --experimental-strip-types --test lib/contact-request.test.ts",
    "test:worker": "node --experimental-strip-types --test worker/index.test.ts",
    "qa:routes:http": "node scripts/qa/check-routes.mjs --base http://127.0.0.1:4173 --include-planned"
  },
  "dependencies": {
    "framer-motion": "12.42.2",
    "next": "16.2.12",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.12.1",
    "cross-env": "7.0.3",
    "playwright-core": "^1.62.1",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
