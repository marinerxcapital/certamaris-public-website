{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "certamaris-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
