# Public site URL — used for canonical links, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://certamaris.com

# ---------------------------------------------------------------------------
# INTEGRATION POINTS — the future Lovable application
# ---------------------------------------------------------------------------
# These four values are the seams between this marketing site and the
# authenticated product application. Until they're set, the site falls back
# to placeholder URLs/addresses so nothing silently breaks in development.

# Where "Sign in" in the nav should send visitors once the app is live.
NEXT_PUBLIC_APP_SIGN_IN_URL=https://app.certamaris.com/sign-in

# Where "Get started" in the nav should send visitors once the app is live.
NEXT_PUBLIC_APP_GET_STARTED_URL=https://app.certamaris.com/get-started

# Optional: a scheduling/calendar embed URL (e.g. Calendly, Cal.com) for
# "Book a demo". Leave blank to keep using the on-page contact form only.
NEXT_PUBLIC_APP_SCHEDULING_URL=

# Fallback mailto address shown on the Contact page for "Contact Sales".
NEXT_PUBLIC_APP_SALES_EMAIL=sales@certamaris.com

# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix). When set, the /api/contact route
# forwards submissions as JSON to this endpoint. Only used on Node deployments
# (Vercel, etc.) where /api/contact actually runs.
CONTACT_FORWARD_ENDPOINT=

# Client-callable alternative for static-export deployments (e.g. Netlify
# without a Node runtime), where /api/contact isn't available at all. Set
# this to a publicly callable endpoint accepting the same JSON body
# ({ name, email, company, fleetSize, message }) and the contact form will
# POST to it directly from the browser instead. Leave both this and
# CONTACT_FORWARD_ENDPOINT blank during local development — submissions are
# still validated but only logged server-side, and the UI never claims
# delivery it can't back up. Submissions should never log personal contact
# details when delivery is not configured.
NEXT_PUBLIC_CONTACT_ENDPOINT=
