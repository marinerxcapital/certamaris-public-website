# Public site URL — used for canonical links, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://certamaris.com

# ---------------------------------------------------------------------------
# INTEGRATION POINTS — the future Lovable application
# ---------------------------------------------------------------------------
# These four values are the seams between this marketing site and the
# authenticated product application. Until they're set, the site falls back
# to placeholder URLs/addresses so nothing silently breaks in development.

# Where "Sign in" in the nav should send visitors. The app is live; this is
# its real login route.
NEXT_PUBLIC_APP_SIGN_IN_URL=https://app.certamaris.com/auth/login

# Where "Get started" in the nav should send visitors. No self-serve signup
# route exists in the app (enterprise/sales-assisted product), so this
# defaults to this site's own /contact page. Point it at a real app route
# if self-serve signup ever ships.
NEXT_PUBLIC_APP_GET_STARTED_URL=/contact

# Optional: a scheduling/calendar embed URL (e.g. Calendly, Cal.com) for
# "Book a demo". Leave blank to keep using the on-page contact form only.
NEXT_PUBLIC_APP_SCHEDULING_URL=

# Fallback mailto address shown on the Contact page for "Contact Sales".
NEXT_PUBLIC_APP_SALES_EMAIL=sales@certamaris.com

# ---------------------------------------------------------------------------
# Contact form delivery
# ---------------------------------------------------------------------------
# Production runs on a Cloudflare Worker (worker/index.ts) that serves the
# static export and handles POST /api/contact. Delivery bindings/secrets are
# configured in the Cloudflare dashboard or via `wrangler secret put` and are
# NOT committed to source. The worker tries, in order:
#   1. CONTACT_EMAIL (Cloudflare Email Workers binding) + CONTACT_EMAIL_FROM/TO
#   2. CONTACT_FORWARD_ENDPOINT + CONTACT_FORWARD_SECRET (HMAC-signed forwarder)
# Idempotency (CONTACT_IDEMPOTENCY KV) and rate limiting are declared in
# wrangler.jsonc. See worker/index.ts for the full delivery logic.

# Signed-forwarder delivery path (used only when no CONTACT_EMAIL binding).
# The worker POSTs the payload as JSON and signs timestamp+body with the secret.
CONTACT_FORWARD_ENDPOINT=
CONTACT_FORWARD_SECRET=

# Client-callable alternative for deployments where the Worker /api/contact
# route is not running. When set, the contact form POSTs directly to this URL
# from the browser instead of /api/contact. Leave blank for the Cloudflare
# Worker deployment. Submissions must never log personal contact details when
# delivery is not configured.
NEXT_PUBLIC_CONTACT_ENDPOINT=
